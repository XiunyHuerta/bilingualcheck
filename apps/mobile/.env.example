# ─────────────────────────────────────────────────────────────
# BilingualCheck · App Expo (apps/mobile)
# Todo lo que empieza por EXPO_PUBLIC_ termina en el bundle:
# AQUÍ NO VA NINGÚN SECRETO.
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8787     # en dispositivo: IP de tu PC o URL de Vercel
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WHOP_CLIENT_ID=
EXPO_PUBLIC_WHOP_ENV=sandbox                  # sandbox | production
