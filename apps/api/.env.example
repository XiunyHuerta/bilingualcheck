# ─────────────────────────────────────────────────────────────
# BilingualCheck · Backend (apps/api)
# Copia este archivo a .env y rellénalo. NUNCA lo subas a git.
# En Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# General
PORT=8787
PUBLIC_API_URL=http://localhost:8787          # URL pública (Vercel o túnel) para webhooks y callbacks
APP_SCHEME=bilingualcheck                     # deep link de la app
WEB_APP_URL=http://localhost:8081              # origen exacto; producción https://bilingualcheck-app.vercel.app

# Sesión propia (JWT HS256). Usa el "JWT Secret" (legacy) de Supabase
# para que Realtime + RLS acepten el mismo token: Settings → API → JWT Settings.
SESSION_JWT_SECRET=

# Supabase (Settings → API / Database)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_UPLOADS=client-uploads
STORAGE_BUCKET_DELIVERABLES=deliverables

# Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-opus-5-5
AGENT_MAX_TOOL_CALLS=8

# Terac (terac.com → Organization → API keys)
TERAC_MODE=replay                             # live | replay (replay = respuestas grabadas, sin red)
TERAC_BASE_URL=https://terac.com/api/external/v2
TERAC_API_KEY=
TERAC_PROJECT_ID=                             # lo escribe `pnpm terac:setup` (crea el proyecto una vez)
TERAC_WEBHOOK_SECRET=                         # guardar con terac:webhooks; configurar Vercel y luego --confirm <id>
TERAC_DEMO_FEASIBILITY_REQUEST_ID=            # cotización real ya respondida (plan día 0)

# Whop (Developer Dashboard) — trabajar en SANDBOX hasta la demo
WHOP_ENV=sandbox                              # sandbox | production
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=                           # solo si la app OAuth es confidencial
WHOP_API_KEY=
WHOP_ACCOUNT_ID=biz_
WHOP_PRODUCT_ID=prod_
WHOP_WEBHOOK_SECRET=

# Negocio y guardarraíles
FEE_RATE=0.25                                 # comisión BilingualCheck sobre el costo Terac
BUDGET_CAP_USD=300                            # tope global de la demo
TERAC_SPEND_CAP_USD=100                       # tope por cotización del costo del proveedor (sin comisión de la app)
CRON_SECRET=                                  # Vercel Cron envía "Authorization: Bearer <CRON_SECRET>"
