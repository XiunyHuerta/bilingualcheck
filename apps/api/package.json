{
  "name": "@bc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "terac:setup": "tsx --env-file=.env scripts/terac-setup.ts",
    "terac:filters": "tsx --env-file=.env scripts/terac-filters.ts",
    "terac:webhooks": "tsx --env-file=.env scripts/terac-webhooks.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" && node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').writeFileSync('public/robots.txt','User-agent: *\\nDisallow: /\\n')\"",
    "demo:seed": "tsx --env-file=.env scripts/demo-seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bc/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/functions": "^3.10.3",
    "@whop/sdk": "^2.6.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  }
}
